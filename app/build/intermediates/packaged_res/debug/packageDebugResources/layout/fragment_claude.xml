<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_primary">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="8dp"
        android:gravity="center_vertical"
        android:background="@color/bg_secondary">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="MJOLNIR // CLAUDE"
            android:textColor="@color/text_dim"
            android:fontFamily="monospace"
            android:textSize="9sp"
            android:letterSpacing="0.15" />

        <Button
            android:id="@+id/api_key_button"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:text="SET KEY"
            android:textSize="8sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.1"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:backgroundTint="@color/bg_tertiary"
            android:textColor="@color/text_dim" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/message_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp"
        android:clipToPadding="false"
        android:scrollbars="none" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/bg_secondary"
        android:padding="6dp"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/input_field"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="message..."
            android:hintTextColor="@color/text_hint"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:background="@color/bg_tertiary"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:imeOptions="actionSend"
            android:inputType="textMultiLine|textAutoCorrect"
            android:maxLines="4" />

        <Button
            android:id="@+id/send_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:text="↑"
            android:textSize="16sp"
            android:textColor="@color/bg_primary"
            android:backgroundTint="@color/text_primary"
            android:padding="0dp" />
    </LinearLayout>

</LinearLayout>
