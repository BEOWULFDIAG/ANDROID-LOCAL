<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MjolnirTerminal" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:colorBackground">@color/bg_primary</item>
        <item name="colorPrimary">@color/text_primary</item>
        <item name="colorOnPrimary">@color/bg_primary</item>
        <item name="colorSurface">@color/bg_secondary</item>
        <item name="android:statusBarColor">@color/status_bar</item>
        <item name="android:navigationBarColor">@color/bg_primary</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_dim</item>
        <item name="editTextStyle">@style/Widget.MjolnirTerminal.EditText</item>
    </style>

    <style name="Widget.MjolnirTerminal.EditText" parent="Widget.MaterialComponents.TextInputEditText">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="android:background">@color/bg_tertiary</item>
    </style>
</resources>
